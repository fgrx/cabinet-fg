---
import "../styles/global.scss";
import NavBar from "../components/vue/NavBar.vue";
import menus from "../content/params/menu.json";
import generalInfos from "../content/params/general.json"
import Footer from "../components/Footer.astro";
import ContactFabButton from "../components/vue/ContactFabButton.vue";

export interface Props {
  title: string;
}

const { title } = Astro.props;

const fonts ="https://fonts.googleapis.com/css2?family=Average+Sans&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Rufina:wght@400;700&display=swap" ;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="preload" as="style" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- {ogImage && <meta
      property="”og:image”"
      content=`https://tangobucolico.com${ogImage}`
    />
    } -->

    <link
      rel="stylesheet"
      href={fonts}
      media="print"
      onload="this.media='all'"
    />

    <script type="text/partytown" defer src="/plugins/cookie-consent/cookie-consent.js" />
    <script type="text/partytown" defer src="/plugins/cookie-consent/cookie-consent.init.js" />

    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-FVZCQPQSE8"></script>
    <script type="text/partytown" data-cookiecategory="analytics">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FVZCQPQSE8');
    </script>
    
    <title>{title}</title>
  </head>
  <body class="bg-background text-dark">

    <NavBar client:load siteUrl="/" menus={menus} generalInfos={generalInfos} />
    <slot />

    <ContactFabButton client:load />

    <Footer />
  </body>
</html>

<style is:global>
  .menu-site li {
    font-family: "Montserrat";
    text-transform: uppercase;
    font-weight: normal;
    font-size: 1.2em;
  }

  body {
    font-family: "Average Sans" !important;
    color: rgb(69, 69, 69) !important;
    font-size: 1.2em !important;
  }

  h1,
  .title {
    font-family: "rufina" !important;
  }

  h2 {
    font-family: "rufina" !important;
    font-weight: bold !important;
    margin-bottom: 0.1em !important;
    line-height: 1em !important;
  }

  h3 {
    font-family: "rufina" !important;
    font-weight: bold !important;
    margin-top: 0.5em v;
    line-height: 1em !important;
  }
</style>
